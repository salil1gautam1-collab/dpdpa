# TrackVault configuration — copy to .env and fill in. .env is gitignored.
# ---------------------------------------------------------------------------
# Email notifications. Leave TRACKVAULT_SMTP_HOST BLANK to keep email in
# "simulated" mode (nothing is sent; deliveries are still logged). Fill the
# host + credentials to send real email. Never commit .env.

TRACKVAULT_SMTP_FROM=info@dedicatusit.com

# --- fill these to go live ---
# Zoho Mail: host is smtp.zoho.in (India DC) or smtp.zoho.com (global DC).
# If 2FA is on, use a Zoho app-specific password. Enable IMAP/SMTP in Zoho.
TRACKVAULT_SMTP_HOST=smtp.zoho.in
TRACKVAULT_SMTP_PORT=587
TRACKVAULT_SMTP_USER=info@dedicatusit.com
TRACKVAULT_SMTP_PASS=

# Public URL used for the "sign in" link inside emails
TRACKVAULT_BASE_URL=http://127.0.0.1:8377

# Admin password for the operator dashboard
DPDPA_ADMIN_PASSWORD=dpdpa-admin

# Optional white-label brand name (defaults to TrackVault)
# TRACKVAULT_BRAND=TrackVault

# ============================================================
# CLIENT DATA MUST NEVER BE COMMITTED.
# Everything under local/ is client-specific input, evidence
# and generated reports. It stays on the machine that ran the
# scan. See docs/DATA-PROTECTION-POLICY.md.
# ============================================================
local/
_outbox.json
_rulebooks/
*.client.json
*.evidence.json

# Secrets / environment — never commit
.env
# Cloud/infra credentials — never commit, even if a workspace escapes local/
connectors.json
*.credentials.json

# Python
__pycache__/
*.pyc
.venv/
venv/
build/
dist/
*.spec

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

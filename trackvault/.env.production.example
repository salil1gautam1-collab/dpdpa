# TrackVault production environment — copy to .env and fill in. NEVER commit .env.
# Generate the secrets with:  python scripts/generate_keys.py

TRACKVAULT_ENVIRONMENT=production

# Your public domain (Caddy auto-provisions HTTPS for it)
SITE_ADDRESS=trackvault.example.com
TRACKVAULT_BASE_URL=https://trackvault.example.com

# Database
POSTGRES_USER=trackvault
POSTGRES_PASSWORD=CHANGE-ME-strong-db-password
POSTGRES_DB=trackvault

# Secrets — generate with scripts/generate_keys.py (required; app refuses to boot otherwise)
TRACKVAULT_SECRET_KEY=
TRACKVAULT_ENCRYPTION_KEY=
TRACKVAULT_BOOTSTRAP_ADMIN_EMAIL=admin@yourfirm.com
TRACKVAULT_BOOTSTRAP_ADMIN_PASSWORD=

# Web workers
WEB_CONCURRENCY=4

# Email (optional; blank host = simulated)
TRACKVAULT_SMTP_HOST=
TRACKVAULT_SMTP_PORT=587
TRACKVAULT_SMTP_USER=
TRACKVAULT_SMTP_PASS=
TRACKVAULT_SMTP_FROM=info@dedicatusit.com
# Safety: redirect ALL email here while testing (clear for real client sends)
TRACKVAULT_TEST_RECIPIENT=

# TrackVault environment template.
# Copy to .env and fill in. .env is gitignored — NEVER commit real values.
# The production config gate (app.check_config) refuses to boot with dev defaults.

# ---- Core ----
TRACKVAULT_ENVIRONMENT=development            # development | staging | production
TRACKVAULT_BASE_URL=http://localhost:8000     # public URL (https://... in production)
# Generate both per DEPLOYMENT.md (python -c snippets provided there):
TRACKVAULT_SECRET_KEY=change-me-32-chars-minimum
TRACKVAULT_ENCRYPTION_KEY=                    # Fernet key — encrypts connector credentials

# ---- Database (compose default works out of the box) ----
# TRACKVAULT_DATABASE_URL=postgresql+psycopg://trackvault:trackvault@db:5432/trackvault

# ---- Bootstrap admin (created on first start if missing) ----
TRACKVAULT_BOOTSTRAP_ADMIN_EMAIL=admin@trackvault.local
TRACKVAULT_BOOTSTRAP_ADMIN_PASSWORD=change-me-strong-password

# ---- Email (SMTP; secrets live ONLY here, never in the UI/DB) ----
TRACKVAULT_SMTP_HOST=smtp.zoho.in
TRACKVAULT_SMTP_PORT=587
TRACKVAULT_SMTP_USER=you@yourfirm.com
TRACKVAULT_SMTP_PASS=
TRACKVAULT_SMTP_FROM=you@yourfirm.com
# Safety net: while set, EVERY outgoing email goes only to this address.
# Clear it (or the Settings-page override) to send to real customers.
TRACKVAULT_TEST_RECIPIENT=you@yourfirm.com

# ---- Document conversion (self-hosted reader) ----
TRACKVAULT_AI_PROVIDER=ollama                 # ollama | none
TRACKVAULT_AI_BASE_URL=http://ollama:11434
TRACKVAULT_AI_MODEL=llama3.2:3b               # bigger model + GPU = better prose yield
TRACKVAULT_AI_IMPORT_ENABLED=true             # kill switch for the conversion feature

# ---- Session & rate limits (defaults are sensible; shown for completeness) ----
# TRACKVAULT_SESSION_TTL_HOURS=12
# TRACKVAULT_SESSION_IDLE_MINUTES=60
# TRACKVAULT_LOCKOUT_THRESHOLD=8
# TRACKVAULT_LOCKOUT_MINUTES=15
# TRACKVAULT_RATE_LIMIT_PER_MINUTE=120
# TRACKVAULT_LOGIN_RATE_LIMIT_PER_MINUTE=10
